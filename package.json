{
  "name": "biteexpress-api",
  "version": "1.0.0",
  "private": true,
  "description": "Restaurant discovery API for BiteExpress on MongoDB",
  "license": "ISC",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest src/tests/unit",
    "test:integration": "jest src/tests/integration --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "seed": "ts-node -r tsconfig-paths/register --transpile-only src/scripts/seedRestaurants.ts",
    "explain": "ts-node -r tsconfig-paths/register --transpile-only src/scripts/explainRestaurantQueries.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "envalid": "^9.0.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "mongoose": "^9.12.3",
    "morgan": "^1.12.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
